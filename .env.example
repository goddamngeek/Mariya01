DATABASE_URL=postgresql://user:password@host:5432/dbname
TELEGRAM_BOT_TOKEN=
SYNC_BEARER_TOKEN=

ODYSSEUS_URL=
ODYSSEUS_TOKEN=
# API key for whichever provider is currently enabled in Odysseus's own
# Admin -> Model Endpoints. Leave empty if the endpoint's own configured
# key in Odysseus is sufficient.
LLM_API_KEY=

# Direct Trilium ETAPI access, for the fully-deterministic writes
# (ежедневник) that don't need Odysseus at all. Same instance/token
# Odysseus itself uses — reach it over its own public URL, not the
# internal docker-network one Odysseus's own .env has.
TRILIUM_URL=
TRILIUM_ETAPI_TOKEN=
